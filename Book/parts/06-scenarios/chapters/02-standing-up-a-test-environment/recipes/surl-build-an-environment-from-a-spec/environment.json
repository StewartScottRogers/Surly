{
  "servers": {
    "web": {
      "listen_urls": ["http://127.0.0.1:0"],
      "files": { "health.txt": "ok\n" }
    },
    "mail": {
      "listen_urls": ["smtp://127.0.0.1:0"],
      "arguments": ["--mail-domain", "example.com", "--mailbox", "app@example.com:apppass", "--mailbox", "ann@example.com:annpass"]
    },
    "events": {
      "listen_urls": ["mqtt://127.0.0.1:0"],
      "arguments": ["--user", "app:apppass", "--allow-plaintext-auth", "--topic", "env/#;retain"]
    }
  }
}
