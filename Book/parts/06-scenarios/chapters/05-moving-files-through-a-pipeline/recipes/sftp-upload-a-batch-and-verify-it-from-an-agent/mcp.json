{
  "mcpServers": {
    "surl": {
      "command": "surl-mcp",
      "env": {
        "SURL_MCP_ROOT": "/absolute/path/to/this/folder"
      }
    },
    "curl": {
      "command": "dnx",
      "args": [
        "Surly.Curl.Mcp@0.4.0-preview.5",
        "--yes"
      ],
      "env": {
        "CURL_MCP_ROOT": "/absolute/path/to/this/folder"
      }
    }
  }
}
